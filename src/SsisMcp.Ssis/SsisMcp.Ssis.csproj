<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>SsisMcp.Ssis</RootNamespace>
    <!-- SSIS runtime is x64 on this host; the DTS host must match bitness. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!--
    SSIS assemblies live only in the GAC on this machine (no DTS\Binn folder).
    We reference them by strong name and let MSBuild resolve from the GAC.
    Version 17.0.0.0 == SQL Server 2025 family. When we add a genuine multi-version
    adapter these strong names move behind the SSIS adapter's build configuration.
  -->
  <Import Project="..\..\build\Ssis.References.props" />

  <ItemGroup>
    <ProjectReference Include="..\SsisMcp.Core\SsisMcp.Core.csproj" />
  </ItemGroup>
</Project>
